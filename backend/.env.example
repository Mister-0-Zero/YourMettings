DATABASE_URL=postgresql+psycopg://yourmettings:CHANGE_ME@127.0.0.1:5432/yourmettings
TEST_DATABASE_URL=postgresql+psycopg://yourmettings:CHANGE_ME@127.0.0.1:5432/yourmettings_test
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep stable, private, >=32 bytes. Empty means OTP login/refresh cannot operate.
AUTH_SECRET=
# Exact addresses allowed outside cbr.ru; JSON array. No implicit admin access to others' data.
AUTH_ADMIN_EMAILS=[]
# ONLY this confirmed allowlisted address may claim the preserved legacy UUID/data.
AUTH_LEGACY_ADMIN_EMAIL=
# TLS is mandatory: starttls (usually 587) or ssl (usually 465). No plaintext mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Empty = ignore all proxy headers. Set only the explicit future HTTPS gateway IP/CIDR.
TRUSTED_PROXY_IPS=[]
MAX_JSON_REQUEST_BYTES=2097152
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Set the actual installed tag after the download completes.
OLLAMA_MODEL=
LLM_TIMEOUT_SECONDS=300
MAX_TRANSCRIPT_CHARS=100000
# Optional: existing separate ASR resource home (venv, models, FFmpeg, HF cache).
# Defaults to <repository>/asr; may point at the existing asr worktree.
# ASR_HOME=D:/path/to/asr
ASR_ENABLED=true
ASR_GPU_SERIAL=true
ASR_STARTUP_TIMEOUT_SECONDS=180
ASR_JOB_TIMEOUT_SECONDS=600
AUDIO_CHUNK_TARGET_SECONDS=300
AUDIO_CHUNK_MAX_SECONDS=360
AUDIO_MAX_UPLOAD_BYTES=33554432
AUDIO_MAX_ACTIVE_SESSIONS_PER_USER=10
AUDIO_MAX_PENDING_CHUNKS_PER_USER=48
AUDIO_MAX_PENDING_BYTES_PER_USER=268435456
AUDIO_MAX_CHUNKS=240
AUDIO_MAX_OVERLAP_MS=3000
AUDIO_VALIDATION_TIMEOUT_SECONDS=30

# Temporary shared synthetic demo account. No key is embedded in code/APK.
DEMO_ENABLED=false
DEMO_SECRET=
# Explicit future timezone-aware ISO timestamp required when demo is enabled.
DEMO_EXPIRES_AT=
# Disable for remote gateway deployment; keep backend loopback-only.
BACKEND_LAN_ENABLED=true
